# Copy this file to .env and adjust as needed for local dev.
# Every process (app, worker-workflow, worker-activity) reads from the
# same .env -- values a given process doesn't need are simply unused by
# it (e.g. worker-workflow never touches DATABASE_URL, per CLAUDE.md's
# "Breaking the application <-> workflow cycle").
#
# Docker-internal service names are used throughout (e.g. `db`,
# `temporal`, `keycloak`) rather than localhost -- same discipline
# review-approval-temporal documents for KEYCLOAK_ISSUER (CLAUDE.md's
# "Docker Compose topology"). When running a process directly on the
# host (outside docker compose) instead, swap the service name for
# `localhost` and the container's published port.

# --- Postgres (db service -- loan_onboarding + temporal databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loan_onboarding
DATABASE_URL=postgresql://postgres:postgres@db:5432/loan_onboarding

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# --- Worker process split (worker.py's bootstrap, worker_main.py) ---
# WORKER_MODE: both | workflow | activity
WORKER_MODE=both
# LOAN_PRODUCT_TYPE: personal_loan | auto_loan | mortgage -- left unset
# to poll every product type's task queue (same default
# review-approval-temporal uses for its sibling REVIEW_TYPE var).
LOAN_PRODUCT_TYPE=

# --- Escalation threshold (PRD 6.3) ---
MANAGER_ESCALATION_THRESHOLD_USD=50000

# --- Keycloak (bff_backoffice only -- CLAUDE.md's "Identity") ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://keycloak:8080/realms/loanrealm
KEYCLOAK_CLIENT_ID=loan-onboarding-backoffice
KEYCLOAK_CLIENT_SECRET=dev-secret-change-me
# Signs the Redis-backed /ui/* session id cookie -- separate from the
# Keycloak client secret above.
BACKOFFICE_SESSION_SECRET_KEY=dev-secret-change-me
BACKOFFICE_REDIS_URL=redis://backoffice-redis:6379/0

# --- Customer-side session cookie (bff_customer/identity.py) ---
# Signs the applicant_identifier cookie -- no Redis, nothing
# token-shaped to store (CLAUDE.md's "Identity" -- customer side).
CUSTOMER_SESSION_SECRET_KEY=dev-secret-change-me

# --- Mayan EDMS (document/mayan_client.py) ---
# These follow mayan-edms-customer-archive's own MAYAN_AUTOADMIN_*
# convention for the service-account credentials document/
# authenticates to Mayan's API with.
MAYAN_BASE_URL=http://mayan:8000
MAYAN_SERVICE_ACCOUNT_USERNAME=admin
MAYAN_SERVICE_ACCOUNT_PASSWORD=changeme
# mayan-db's own Postgres password (separate database/container from
# this project's `db` -- see CLAUDE.md's "Data storage").
MAYAN_POSTGRES_PASSWORD=mayan

# --- SMTP (notifications/service.py -- CLAUDE.md's "Real email
# delivery via Gmail SMTP", Phase 20) ---
# Optional. Leave SMTP_USERNAME/SMTP_PASSWORD empty (the default) and
# send_account_closure_decision/send_welcome_letter_email fall through
# to the existing fake print()-only delivery -- send_verification_code
# (the OTP code) is unaffected either way, always fake. Only
# worker-activity (docker-compose.yml) actually reads these; the app
# and worker-workflow processes never call notifications/service.py's
# real-vs-fake branch.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# A Gmail App Password, NOT the account's real password -- Gmail
# requires this for third-party SMTP auth once 2-Step Verification is
# on. Add your own real value only to your local, gitignored .env --
# never commit it, never paste it into a chat session.
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left empty -- Gmail's own SMTP relay
# requires the From: header to match the authenticated account (or a
# configured "Send As" alias, which this POC doesn't set up).
SMTP_FROM_ADDRESS=

# --- Automated risk assessment via NATS (risk/service.py -- CLAUDE.md's
# "Automated risk assessment via NATS" / the risk-assessment-nats
# skill, Phase 21) ---
# Docker-internal service name for the standalone NATS Adapter --
# risk/ never talks to NATS itself, only this one HTTP endpoint. Only
# worker-activity actually reads this (application/activities.py's
# submit_risk_assessment activity calls risk.service from there); the
# app and worker-workflow processes never call risk/service.py.
RISK_ADAPTER_URL=http://risk-adapter:8000
